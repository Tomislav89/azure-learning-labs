.azure/

# Kubernetes configuration
kubeconfig
*.kubeconfig

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# Operating system
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.bak

# Logs
*.log
